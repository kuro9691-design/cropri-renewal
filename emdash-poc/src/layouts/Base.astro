---
import { getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/site.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	fullWidth?: boolean;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content, fullWidth = false } =
	Astro.props;
const settingsResult = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
}

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header class="site-header">
			<nav class="site-nav" aria-label="メインメニュー">
				<a class="site-brand" href="/" aria-label={`${siteTitle} ホーム`}>
					<img src="/cropri/home/cropri-header-wordmark.svg" alt="CROPRI" />
				</a>
				<div class="site-links">
					<a href="/products/5001">T-SHIRTS</a>
					<a href="/#categories">GOODS</a>
					<a href="/print-methods">PRINT</a>
					<a href="/works">WORKS</a>
					<a href="/about">ABOUT</a>
					<a href="/faq">FAQ</a>
					<a href="/posts">JOURNAL</a>
				</div>
				<div class="site-actions">
					<LiveSearch placeholder="商品を検索" collections={["products"]} />
					<a class="site-action-link" href="/estimate">料金を計算する</a>
					<a class="site-action-link" href="/contact">お問い合わせ</a>
				</div>
			</nav>
		</header>

		<main class:list={["site-main", { "site-main--full": fullWidth }]}>
			<slot />
		</main>
		<SiteFooter />

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
