---
const categories = [
	["Tシャツ","定番のTシャツ。チームのユニフォームに。","/products/5001","2.4%","45.4%"],
	["ドライTシャツ","速乾性に優れた機能性Tシャツ。","/contact","21.7%","45.4%"],
	["ポロシャツ","きちんとした印象でスタッフウェアに。","/contact","41.2%","45.4%"],
	["長袖Tシャツ","季節を問わず使える定番の長袖。","/contact","59.6%","45.4%"],
	["スウェット","チームウェアや物販にも人気。","/contact","78.3%","45.4%"],
	["トートバッグ","ショップグッズやイベント用に。","/contact","98%","45.4%"],
	["タオル・手ぬぐい","日常使いできるオリジナルタオル。","/contact","2.4%","59.1%"],
	["アウター","季節のスタッフウェアとして活躍。","/contact","21.7%","59.1%"],
	["ワークシャツ","飲食店の定番スタッフシャツ。","/contact","41.2%","59.1%"],
	["エプロン","飲食店やショップの定番ユニフォーム。","/contact","59.6%","59.1%"],
	["キャップ","スタッフの定番アイテム。","/contact","78.3%","59.1%"],
	["マグ・グッズ","マグカップなどオリジナルグッズに。","/contact","98%","59.1%"],
];
const works = [
	["飲食店のユニフォーム","レストラン・カフェ・バーなど、日々の現場で活躍するウェア。","4.1%"],
	["ショップ・カフェのスタッフウェア","お店の個性を引き出す、オリジナルTシャツやグッズ。","51.5%"],
	["イベントのチームウェア","地域のイベントやフェスで、一体感のあるウェアを。","96%"],
];
---
<section class="hero" aria-label="CROPRI オリジナルプリントグッズ">
	<img src="/cropri/home/hero-left-brand-panel.png" alt="CROPRI ORIGINAL PRINT GOODS" width="562" height="391" />
	<img src="/cropri/home/hero-right-feature-image.png" alt="オリジナルTシャツを着用して働く飲食店スタッフ" width="466" height="387" />
</section>
<div class="home-shell">
	<section class="intro" aria-labelledby="intro-title">
		<p class="eyebrow">ORIGINAL WEAR FOR EVERYDAY WORK</p>
		<h1 id="intro-title">毎日に馴染む、オリジナルウェア。</h1>
		<p>CROPRIは、飲食店・カフェ・ショップ・イベントなど、さまざまなチームのオリジナルウェアをつくるプリントサービスです。<br />日々の仕事に寄り添う、着心地のよいウェアで、あなたのチームらしさをかたちにします。</p>
	</section>
	<nav class="start-grid" aria-label="ご相談の入口">
		<a href="#categories"><span>01 / ITEM</span><strong>商品から選ぶ</strong><p>Tシャツ・スウェット・ポロシャツ・バッグなど、豊富なアイテムから選べます。</p><b>→</b></a>
		<a href="/estimate"><span>02 / PRICE</span><strong>料金を計算する</strong><p>枚数やアイテム・プリント方法から、かんたんに見積もりができます。</p><b>→</b></a>
		<a href="/contact"><span>03 / DESIGN</span><strong>デザインから相談する</strong><p>イメージが決まっていなくても大丈夫。プロが一緒にデザインを提案します。</p><b>→</b></a>
	</nav>
	<section id="categories" class="categories" aria-labelledby="category-title">
		<div class="category-tabs" id="category-title"><a href="/products/5001">T-SHIRTS</a><a href="#categories">SWEATSHIRTS</a><a href="#categories">TOTE BAGS</a><a href="#categories">CAPS</a><a href="#categories">TOWELS &amp; GOODS</a></div>
		<div class="category-grid">
			{categories.map(([title,copy,href,x,y]) => <a class="category-card" href={href}>
				<div class="sprite product-sprite" style={`--sprite-x:${x};--sprite-y:${y}`} role="img" aria-label={`${title}の商品イメージ`}></div>
				<h2>{title}</h2><p>{copy}</p>
			</a>)}
		</div>
	</section>
	<section id="works" class="works" aria-labelledby="works-title">
		<div class="section-head"><div><p class="eyebrow">OUR WORK</p><h2 id="works-title">飲食店の制作イメージ</h2></div><a href="/works">制作事例ページ <span aria-hidden="true">→</span></a></div>
		<div class="works-grid">
			{works.map(([title,copy,x]) => <article><div class="sprite work-sprite" style={`--sprite-x:${x}`} role="img" aria-label={`${title}のイメージ`}></div><h3>{title}</h3><p>{copy}</p></article>)}
		</div>
	</section>
	<section class="order" aria-labelledby="order-title">
		<div class="section-head"><div><p class="eyebrow">HOW TO ORDER</p><h2 id="order-title">ご注文の流れ</h2></div></div>
		<div class="order-grid">
			<div><i>1</i><strong>商品を選ぶ</strong><p>ご希望のアイテムを選択。</p></div><div><i>2</i><strong>注文フォームに記入</strong><p>商品・色・サイズ・枚数などを入力。</p></div><div><i>3</i><strong>デザインを相談</strong><p>イメージに合わせて一緒に整理。</p></div><div><i>4</i><strong>プリント内容を確認</strong><p>見積内容とご相談のうえ制作。</p></div>
			<a href="/contact">ORDER NOW <span aria-hidden="true">→</span><small>まずはお気軽にご相談ください。</small></a>
		</div>
	</section>
</div>
<style>
.hero{display:grid;grid-template-columns:1fr 1fr;background:#111}.hero img{display:block;width:100%;height:auto;aspect-ratio:1.44/1;object-fit:cover}.home-shell{width:min(100% - 48px,1320px);margin-inline:auto;color:var(--navy)}.intro{padding:64px 20px 34px;max-width:920px}.eyebrow{margin:0 0 12px;color:var(--red);font-size:10px;font-weight:900;letter-spacing:.18em}.intro h1{margin:0;color:var(--navy);font-size:clamp(30px,4.2vw,54px);line-height:1.18;letter-spacing:-.045em}.intro>p:last-child{margin:18px 0 0;font-size:15px;line-height:1.9;color:#35415b}.start-grid{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid #ccd1da}.start-grid a{display:grid;grid-template-columns:1fr auto;gap:8px 18px;padding:27px 32px;color:var(--navy);text-decoration:none;border-right:1px solid #ccd1da}.start-grid a:last-child{border-right:0}.start-grid span{grid-column:1/-1;color:var(--red);font-size:9px;font-weight:900;letter-spacing:.15em}.start-grid strong{font-size:21px}.start-grid p{grid-column:1/2;margin:0;font-size:12px;line-height:1.7;color:#667087}.start-grid b{grid-column:2;grid-row:2/4;align-self:center;color:var(--red);font-size:24px}.categories{padding:58px 0 72px}.category-tabs{display:flex;overflow-x:auto;margin-bottom:24px}.category-tabs a{padding:0 28px;color:var(--navy);font-size:12px;font-weight:900;letter-spacing:.1em;text-decoration:none;white-space:nowrap;border-right:1px solid #8e96a7}.category-tabs a:first-child{padding-left:0}.category-tabs a:last-child{border-right:0}.category-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:30px 10px}.category-card{color:var(--navy);text-decoration:none;min-width:0}.sprite{background-image:url('/cropri/home/approved-concept-sprite.png');background-repeat:no-repeat}.product-sprite{aspect-ratio:137/142;background-size:644.6% auto;background-position:var(--sprite-x) var(--sprite-y);background-color:#f1f0ed}.category-card h2{margin:10px 4px 0;color:var(--navy);font-size:13px;line-height:1.35}.category-card p{margin:5px 4px 0;color:#667087;font-size:11px;line-height:1.55}.section-head{display:flex;justify-content:space-between;align-items:end;padding-bottom:18px;border-bottom:1px solid #ccd1da}.section-head h2{margin:0;color:var(--navy);font-size:clamp(28px,3vw,40px);letter-spacing:-.04em}.section-head>a{color:var(--red);font-size:11px;font-weight:900;text-decoration:none}.works{padding-bottom:70px}.works-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:24px}.work-sprite{aspect-ratio:275/215;background-size:321.1% auto;background-position:var(--sprite-x) 80%;background-color:#eee}.works-grid h3{margin:13px 0 6px;font-size:14px}.works-grid p{margin:0;color:#667087;font-size:12px;line-height:1.65}.order{padding-bottom:68px}.order-grid{display:grid;grid-template-columns:repeat(4,1fr) auto;border-bottom:1px solid #ccd1da}.order-grid>div{display:grid;grid-template-columns:32px 1fr;gap:4px 10px;padding:26px 18px;border-right:1px solid #ccd1da}.order-grid i{grid-row:1/3;width:25px;height:25px;border-radius:50%;display:grid;place-items:center;background:#111;color:#fff;font-style:normal;font-weight:900;font-size:12px}.order-grid strong{font-size:12px}.order-grid p{margin:0;color:#7a8293;font-size:10px;line-height:1.5}.order-grid>a{align-self:center;margin-left:24px;padding:15px 22px;background:var(--red);color:#fff;text-decoration:none;font-size:11px;font-weight:900;letter-spacing:.08em}.order-grid>a small{display:block;margin-top:7px;font-size:8px;font-weight:500;letter-spacing:0}
@media(max-width:980px){.category-grid{grid-template-columns:repeat(4,1fr)}.order-grid{grid-template-columns:repeat(2,1fr)}.order-grid>a{margin:20px 0;justify-self:start}.hero img{aspect-ratio:1.25/1}}
@media(max-width:720px){.hero{grid-template-columns:1fr}.hero img{aspect-ratio:auto}.home-shell{width:min(100% - 32px,1320px)}.intro{padding:44px 0 28px}.intro>p:last-child br{display:none}.start-grid{grid-template-columns:1fr}.start-grid a{padding:22px 8px;border-right:0;border-bottom:1px solid #ccd1da}.start-grid a:last-child{border-bottom:0}.category-grid{grid-template-columns:repeat(2,1fr);gap:26px 10px}.categories{padding:42px 0 54px}.category-tabs a{padding-inline:18px}.works-grid{grid-template-columns:1fr;gap:34px}.order-grid{grid-template-columns:1fr}.order-grid>div{border-right:0;border-bottom:1px solid #ccd1da;padding-inline:8px}.order-grid>a{margin:22px 0}}
</style>
