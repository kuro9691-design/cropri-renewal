---
import Base from "../layouts/Base.astro";
import InfoPage from "../components/InfoPage.astro";
import { printMethods } from "../data/printMethods";
---

<Base title="プリント・加工方法" description="仕上がり、枚数、素材、デザインからCROPRIのプリント・加工方法を比較できます。">
	<InfoPage eyebrow="PRINT METHODS" title="仕上がりと条件から、加工方法を選ぶ。" lead="色数、枚数、素材、表現したいデザインによって、向いている方法が変わります。気になる仕上がりから詳細を確認し、迷った場合は用途と枚数をお知らせください。">
		<section class="method-guide" aria-labelledby="guide-title">
			<div><p class="section-kicker">QUICK GUIDE</p><h2 id="guide-title">まずは、作りたいものに近い条件から。</h2></div>
			<ul>
				<li><strong>少ない色数 × まとまった枚数</strong><span>シルクスクリーン</span></li>
				<li><strong>写真・グラデーション × 少数</strong><span>DTG</span></li>
				<li><strong>多色・細かな柄 × 幅広い素材</strong><span>DTF</span></li>
				<li><strong>名前・番号 × 1枚ずつ変更</strong><span>ナンバー＆ネーム</span></li>
			</ul>
		</section>

		<section class="method-section" aria-labelledby="method-list-title">
			<div class="section-heading">
				<div><p class="section-kicker">TECHNIQUES</p><h2 id="method-list-title">8つの加工方法</h2></div>
				<p>画像は仕上がりと工程を伝えるためのCROPRI用イメージです。商品・素材・データにより実際の加工条件は変わります。</p>
			</div>
			<div class="method-grid">
				{printMethods.map((method) => (
					<a class="method-card" href={`/print-methods/${method.slug}`}>
						<div class="method-image"><img src={method.image} alt={method.imageAlt} loading="lazy" /></div>
						<div class="method-body">
							<div class="method-meta"><span>{method.code}</span><span class:list={["method-status", { "is-estimate": method.status === "estimate" }]}>{method.status === "estimate" ? "概算対応" : "要相談"}</span></div>
							<h3>{method.name}</h3><p>{method.tagline}</p><span class="method-link">詳しく見る <span aria-hidden="true">→</span></span>
						</div>
					</a>
				))}
			</div>
		</section>

		<section class="closing">
			<p class="section-kicker">NOT SURE?</p><h2>加工名が分からなくても大丈夫です。</h2>
			<p>商品、枚数、使いたい日、デザインの状態を分かる範囲でお知らせください。仕上がりと条件を確認して候補をご案内します。</p>
			<div class="closing-actions"><a class="info-cta" href="/estimate">料金を計算する</a><a class="text-link" href="/contact">相談する →</a></div>
		</section>
	</InfoPage>
</Base>

<style>
	:global(.info-page .info-hero h1){font-size:clamp(34px,4vw,42px)!important}
	.section-kicker{margin:0 0 8px!important;color:var(--red);font-size:10px!important;font-weight:900;letter-spacing:.18em}
	.method-guide{display:grid;grid-template-columns:.85fr 1.15fr;gap:38px;align-items:start;padding:30px!important;background:#f6f3ed;border:0!important}
	.method-guide ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;margin:0!important;padding:0!important;background:#d5d6d7;list-style:none}
	.method-guide li{display:flex;min-height:104px;flex-direction:column;justify-content:space-between;padding:18px;background:#fff;font-size:12px!important}
	.method-guide li span{color:var(--red);font-size:11px;font-weight:900}
	.section-heading{display:flex;justify-content:space-between;gap:36px;align-items:end;margin-bottom:22px}.section-heading>p{max-width:440px;margin:0!important;color:#657087;font-size:12px!important}
	.method-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
	.method-card{display:block;overflow:hidden;border:1px solid #d8dce3;background:#fff;color:inherit!important;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease}.method-card:hover{transform:translateY(-3px);box-shadow:0 14px 34px rgba(20,30,50,.1)}.method-card:focus-visible{outline:3px solid var(--red);outline-offset:3px}
	.method-image{aspect-ratio:16/10;overflow:hidden;background:#ece9e2}.method-image img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .45s ease}.method-card:hover img{transform:scale(1.025)}
	.method-body{padding:22px}.method-meta{display:flex;justify-content:space-between;gap:12px;align-items:center;color:var(--red);font-size:9px;font-weight:900;letter-spacing:.13em}.method-status{padding:5px 8px;border:1px solid #c9ced8;color:#687289;letter-spacing:.05em}.method-status.is-estimate{border-color:#e74c3c;color:#b62f26}
	.method-body h3{margin:14px 0 9px!important;font-size:23px!important}.method-body p{min-height:54px;margin:0!important;color:#566177;font-size:13px!important;line-height:1.7!important}.method-link{display:inline-block;margin-top:18px;color:var(--navy);font-size:11px;font-weight:900;letter-spacing:.04em}
	.closing{padding:34px!important;background:var(--navy);color:#fff;border:0!important}.closing h2{color:#fff!important}.closing>p:not(.section-kicker){max-width:650px;color:#dce3ef}.closing-actions{display:flex;gap:20px;align-items:center}.closing .text-link{color:#fff!important}
	@media(max-width:760px){.method-guide{grid-template-columns:1fr;gap:20px;padding:22px!important}.method-guide ul,.method-grid{grid-template-columns:1fr}.section-heading{display:block}.section-heading>p{margin-top:10px!important}.method-body p{min-height:0}.closing{padding:26px 22px!important}.closing-actions{align-items:flex-start;flex-direction:column;gap:10px}}
</style>
