---
import Base from "../layouts/Base.astro";
import InfoPage from "../components/InfoPage.astro";

const faqs = [
	["何枚から見積もりできますか？", "1枚から概算を確認できます。150枚以上や特殊な仕様は、詳細見積もりからご相談ください。"],
	["デザインが決まっていなくても相談できますか？", "はい。用途、枚数、希望する雰囲気など、現時点で分かる範囲をお知らせください。"],
	["データを入稿できますか？", "入稿前に、加工方法とデータの内容を確認します。対応形式や線幅などの条件は仕様で異なるため、まずはデザインガイドかお問い合わせからご確認ください。"],
	["納期はどれくらいですか？", "商品の在庫、枚数、加工方法、入稿内容によって変わります。希望日がある場合は、見積もり時にお知らせください。"],
	["再注文はできますか？", "前回の注文内容を確認のうえご案内します。商品の廃番、色や仕様の変更、版の状態などにより同一条件では承れない場合があります。"],
	["キャンセルや作り直しについて教えてください。", "注文確定後は個別製作となるため、進行状況によって対応が異なります。詳細は「キャンセル・返品・再製作について」をご確認ください。"],
];
---
<Base title="よくある質問" description="CROPRIの見積もり、デザイン、入稿、納期などに関するよくある質問。">
	<InfoPage eyebrow="FAQ" title="よくある質問" lead="ご相談前に確認したいことをまとめました。商品や加工条件により回答が変わる場合は、個別にご案内します。" notice="公開前確認：キャンセル条件、再製作の基準、支払い方法は、CROPRIの実運用と照合して確定する必要があります。">
		<section>{faqs.map(([question, answer]) => <details><summary>{question}</summary><div><p>{answer}</p></div></details>)}</section>
		<section><h2>解決しない場合</h2><p>商品、枚数、使用日、現在のデザイン状況を分かる範囲でお知らせください。</p><a class="info-cta" href="/contact">お問い合わせへ</a></section>
	</InfoPage>
</Base>
