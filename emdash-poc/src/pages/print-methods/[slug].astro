---
import Base from "../../layouts/Base.astro";
import { getPrintMethod, printMethods } from "../../data/printMethods";

const { slug } = Astro.params;
const method = slug ? getPrintMethod(slug) : undefined;
if (!method) return Astro.rewrite("/404");
const related = printMethods.filter((item) => item.slug !== method.slug).slice(0, 3);
---

<Base title={method.name} description={method.summary} image={method.image}>
	<article class="method-detail">
		<nav class="breadcrumbs" aria-label="パンくず"><a href="/">HOME</a><span>/</span><a href="/print-methods">PRINT METHODS</a><span>/</span><span>{method.name}</span></nav>
		<header class="detail-hero">
			<div class="detail-copy">
				<p class="eyebrow">{method.code}</p><h1>{method.name}</h1><p class="tagline">{method.tagline}</p><p class="summary">{method.summary}</p>
				<div class="hero-actions"><a class="primary-action" href={method.status === "estimate" ? "/estimate" : "/contact"}>{method.status === "estimate" ? "条件から見積もる" : "この加工を相談する"}</a><a href="/print-methods">一覧へ戻る</a></div>
			</div>
			<figure><img src={method.image} alt={method.imageAlt} /><figcaption>加工工程を伝えるためのイメージ画像です。</figcaption></figure>
		</header>

		<section class="fit-section">
			<div><p class="section-kicker">GOOD FOR</p><h2>こんな仕上がり・条件に</h2></div>
			<ul>{method.fit.map((item) => <li>{item}</li>)}</ul>
		</section>

		<div class="detail-columns">
			<section><p class="section-kicker">FEATURES</p><h2>特徴</h2><ul class="body-list">{method.features.map((item) => <li>{item}</li>)}</ul></section>
			<section><p class="section-kicker">CHECK</p><h2>確認しておきたいこと</h2><ul class="body-list">{method.cautions.map((item) => <li>{item}</li>)}</ul></section>
		</div>

		<section class="process-section">
			<div><p class="section-kicker">PROCESS</p><h2>仕上がるまで</h2></div>
			<ol>{method.steps.map((step, index) => <li><span>0{index + 1}</span><p>{step}</p></li>)}</ol>
		</section>

		{method.slug === "silk-screen" && (
			<section class="process-guide">
				<div class="process-guide-copy">
					<p class="section-kicker">HOW IT WORKS</p>
					<h2><span>シルクスクリーン</span><span>プリントのしくみ</span></h2>
					<p>デザインの黒い部分を版の穴に変え、そこからインクを押し出して生地へ刷ります。写真だけでは見えにくい工程を、5つの流れで説明します。</p>
				</div>

				<ol class="screen-steps" aria-label="シルクスクリーンプリントの5工程">
					<li>
						<div class="step-heading"><span>1</span><h3>デザインを作る</h3></div>
						<div class="step-art step-art--design" aria-hidden="true"><strong>CROPRI</strong><i></i></div>
						<p>プリントしたいデザインを、白と黒の2色で作成します。</p>
					</li>
					<li>
						<div class="step-heading"><span>2</span><h3>版を作る</h3></div>
						<div class="step-art step-art--stencil" aria-hidden="true"><span><strong>CROPRI</strong></span></div>
						<p>デザインの黒い部分が、インクの通る穴になるよう製版します。</p>
					</li>
					<li>
						<div class="step-heading"><span>3</span><h3>インクをのせる</h3></div>
						<div class="step-art step-art--ink" aria-hidden="true"><span><strong>CROPRI</strong></span><i></i></div>
						<p>スクリーンの上に、プリントする色のインクをのせます。</p>
					</li>
					<li>
						<div class="step-heading"><span>4</span><h3>インクを押し出す</h3></div>
						<div class="step-art step-art--squeegee" aria-hidden="true"><span><strong>CROPRI</strong></span><i></i></div>
						<p>スキージーでインクを押し出し、生地へデザインを転写します。</p>
					</li>
					<li>
						<div class="step-heading"><span>5</span><h3>インクが生地に残る</h3></div>
						<div class="step-art step-art--print" aria-hidden="true"><span>CROPRI</span></div>
						<p>版の穴が開いた部分だけにインクがのり、デザインが印刷されます。</p>
					</li>
				</ol>

				<div class="screen-explainers">
					<article class="ink-change">
						<p class="section-kicker">INK CHANGE</p>
						<h3>同じ版で、インクの色だけを変えられます</h3>
						<p>白いTシャツには赤インク、黒いTシャツには白インクというように、ボディに合わせて色を選べます。デザインデータと版は同じなので形は変わりませんが、濃色ボディでは明暗が反転したように見えます。</p>
						<div class="shirt-pair" aria-label="白いTシャツに赤インク、黒いTシャツに白インクの仕上がり例">
							<figure><div class="shirt shirt--white"><span>CROPRI</span></div><figcaption>白いTシャツ × 赤インク</figcaption></figure>
							<figure><div class="shirt shirt--dark"><span>CROPRI</span></div><figcaption>黒いTシャツ × 白インク</figcaption></figure>
						</div>
					</article>

					<article class="screen-cross-section">
						<p class="section-kicker">CROSS SECTION</p>
						<h3>インクが生地に届くまで</h3>
						<div class="cross-section-visual" aria-hidden="true"><i class="squeegee"></i><i class="ink"></i><i class="screen"></i><i class="fabric"></i></div>
						<dl>
							<div><dt>スキージー</dt><dd>スクリーンの上からインクを押し出します。</dd></div>
							<div><dt>スクリーン版</dt><dd>デザイン部分の穴だけにインクを通します。</dd></div>
							<div><dt>Tシャツ生地</dt><dd>通り抜けたインクが、生地の表面に定着します。</dd></div>
						</dl>
					</article>

					<article class="print-texture">
						<p class="section-kicker">PRINT TEXTURE</p>
						<h3>仕上がりは、インクの凹凸まで感じられます</h3>
						<p>生地の上にインクがしっかり残るため、輪郭がはっきりし、色にも存在感が出ます。</p>
						<div class="texture-pair" aria-hidden="true"><span class="texture texture--red">CR</span><span class="texture texture--white">CR</span></div>
					</article>
				</div>
			</section>
		)}

		<aside class="notice"><strong>最終仕様は商品とデータを確認して決定します。</strong><p>同じ加工名でも、生地素材、商品サイズ、加工位置、デザインの線幅や色によって対応条件が変わります。画像は仕上がりの方向を伝えるためのイメージで、実際の制作事例ではありません。</p></aside>

		<section class="next-action">
			<div><p class="section-kicker">NEXT STEP</p><h2>{method.status === "estimate" ? "枚数と加工位置から、概算を確認。" : "商品とデザインを見ながら、加工可否を確認。"}</h2></div>
			<a class="primary-action" href={method.status === "estimate" ? "/estimate" : "/contact"}>{method.status === "estimate" ? "料金を計算する" : "相談する"}</a>
		</section>

		<section class="related-section"><p class="section-kicker">OTHER METHODS</p><h2>ほかの加工方法</h2><div class="related-grid">{related.map((item) => <a href={`/print-methods/${item.slug}`}><img src={item.image} alt="" loading="lazy" /><span><small>{item.code}</small><strong>{item.name}</strong></span></a>)}</div></section>
	</article>
</Base>

<style>
	.method-detail{width:min(100%,1120px);margin-inline:auto;color:#26324a}
	.breadcrumbs{display:flex;gap:9px;align-items:center;margin:0 0 26px;color:#7a8394;font-size:9px;font-weight:800;letter-spacing:.08em}.breadcrumbs a{color:inherit;text-decoration:none}.breadcrumbs a:hover{color:var(--red)}
	.detail-hero{display:grid;grid-template-columns:.88fr 1.12fr;gap:46px;align-items:center;padding-bottom:54px;border-bottom:1px solid #d8dce3}
	.eyebrow,.section-kicker{margin:0 0 10px;color:var(--red);font-size:10px;font-weight:900;letter-spacing:.18em}
	.detail-copy h1{margin:0;color:var(--navy);font-size:clamp(38px,4vw,52px);line-height:1.05;letter-spacing:-.055em}.tagline{margin:18px 0 0;color:var(--navy);font-size:19px;font-weight:850;line-height:1.55}.summary{margin:18px 0 0;color:#59647a;font-size:14px;line-height:1.9}
	.detail-hero figure{margin:0}.detail-hero img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}.detail-hero figcaption{margin-top:8px;color:#8a91a0;font-size:9px}
	.hero-actions{display:flex;gap:18px;align-items:center;margin-top:28px}.hero-actions>a:not(.primary-action){color:var(--navy);font-size:11px;font-weight:900;text-underline-offset:4px}.primary-action{display:inline-block;padding:14px 20px;background:var(--red);color:#fff;text-decoration:none;font-size:12px;font-weight:900;letter-spacing:.04em}
	.fit-section{display:grid;grid-template-columns:.8fr 1.2fr;gap:40px;align-items:start;padding:48px 0;border-bottom:1px solid #d8dce3}.fit-section h2,.detail-columns h2,.process-section h2,.next-action h2,.related-section h2{margin:0;color:var(--navy);font-size:clamp(24px,3vw,34px);letter-spacing:-.03em}.fit-section ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:0;padding:0;list-style:none}.fit-section li{padding:15px 17px;border-left:3px solid var(--red);background:#f5f3ee;font-size:13px;font-weight:800}
	.detail-columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:56px;padding:54px 0;border-bottom:1px solid #d8dce3}.body-list{margin:22px 0 0;padding:0;list-style:none}.body-list li{position:relative;padding:15px 0 15px 22px;border-top:1px solid #e0e3e8;font-size:13px;line-height:1.8}.body-list li::before{content:"";position:absolute;left:2px;top:24px;width:6px;height:6px;background:var(--red)}
	.process-section{display:grid;grid-template-columns:.7fr 1.3fr;gap:50px;padding:54px 0;border-bottom:1px solid #d8dce3}.process-section ol{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;margin:0;padding:0;background:#d8dce3;list-style:none}.process-section li{min-height:156px;padding:20px;background:#fff}.process-section li span{color:var(--red);font-size:11px;font-weight:900}.process-section li p{margin:42px 0 0;color:var(--navy);font-size:13px;font-weight:850;line-height:1.6}
	.process-guide{padding:72px 0 76px;border-bottom:1px solid #d8dce3}.process-guide-copy{display:grid;grid-template-columns:.72fr 1.28fr;column-gap:72px;align-items:start;margin-bottom:44px}.process-guide-copy .section-kicker{grid-column:1}.process-guide-copy h2{grid-column:1;margin:0;color:var(--navy);font-size:clamp(24px,3vw,34px);letter-spacing:-.03em}.process-guide-copy>p:last-child{grid-column:2;grid-row:1 / span 2;margin:0;color:#59647a;font-size:14px;line-height:2}
	.process-guide-copy h2 span{display:block}.screen-steps{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:24px;margin:0;padding:0;list-style:none}.screen-steps>li{grid-column:span 2;display:flex;min-height:410px;flex-direction:column;padding:26px;border:1px solid #d8dce3;background:#fff}.screen-steps>li:nth-child(4){grid-column:2 / span 2}.screen-steps>li:nth-child(5){grid-column:4 / span 2}.step-heading{display:flex;gap:12px;align-items:center;min-height:44px}.step-heading span{display:grid;width:31px;height:31px;flex:0 0 auto;place-items:center;background:var(--navy);color:#fff;font-size:12px;font-weight:900}.step-heading h3{margin:0;color:var(--navy);font-size:16px;line-height:1.45}.screen-steps>li>p{margin:24px 0 0;color:#59647a;font-size:13px;line-height:1.95}
	.step-art{position:relative;display:grid;min-height:176px;place-items:center;overflow:hidden;margin-top:24px;background:#f1eee7}.step-art strong,.step-art--print span{position:relative;z-index:2;color:var(--navy);font-family:Georgia,serif;font-size:26px;font-style:italic;letter-spacing:-.08em;transform:rotate(-4deg)}.step-art--design i{position:absolute;width:62px;height:62px;border-radius:50%;background:var(--navy);opacity:.12;transform:translate(0,30px)}.step-art--stencil{background:#ba9769}.step-art--stencil>span,.step-art--ink>span,.step-art--squeegee>span{display:grid;width:76%;height:68%;place-items:center;border:9px solid #9a6f3d;background:#70756f}.step-art--stencil strong{color:#f1eee7}.step-art--ink>span,.step-art--squeegee>span{background:#d95343}.step-art--ink strong,.step-art--squeegee strong{color:#9f281e;opacity:.74}.step-art--ink i{position:absolute;top:33px;width:55%;height:12px;border-radius:50%;background:#c33b31}.step-art--squeegee i{position:absolute;z-index:3;top:44px;width:62%;height:17px;background:#3c4148;transform:rotate(-8deg);box-shadow:0 9px 0 #c6b28c}.step-art--print{background:#eee8dc}.step-art--print::after{content:"";position:absolute;inset:24px 20%;border-radius:50% 50% 12% 12%;background:#fff}.step-art--print span{color:#d63f33}
	.screen-explainers{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px;margin-top:68px}.screen-explainers article{padding:38px;border:1px solid #d8dce3;background:#f7f5f0}.screen-explainers article:first-child{grid-row:span 2}.screen-explainers h3{margin:0;color:var(--navy);font-size:clamp(20px,2vw,24px);line-height:1.55;letter-spacing:-.02em}.screen-explainers article>p:not(.section-kicker){margin:22px 0 0;color:#59647a;font-size:13px;line-height:2}
	.shirt-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-top:34px}.shirt-pair figure{margin:0}.shirt{display:grid;min-height:190px;place-items:center;clip-path:polygon(23% 0,38% 0,42% 8%,58% 8%,62% 0,77% 0,100% 17%,85% 38%,77% 32%,77% 100%,23% 100%,23% 32%,15% 38%,0 17%);filter:drop-shadow(0 7px 8px rgba(38,50,74,.14))}.shirt span{font-family:Georgia,serif;font-size:24px;font-weight:900;font-style:italic;letter-spacing:-.08em;transform:rotate(-5deg)}.shirt--white{background:#fff}.shirt--white span{color:#d63f33}.shirt--dark{background:#172034}.shirt--dark span{color:#fff}.shirt-pair figcaption{margin-top:12px;color:#59647a;font-size:11px;font-weight:800;line-height:1.55;text-align:center}
	.cross-section-visual{position:relative;height:120px;margin:30px 0;background:#fff}.cross-section-visual i{position:absolute;left:12%;right:12%}.cross-section-visual .fabric{bottom:18px;height:18px;background:repeating-linear-gradient(45deg,#d8d1c4 0 4px,#eee9e0 4px 8px)}.cross-section-visual .screen{bottom:45px;height:9px;background:repeating-linear-gradient(90deg,#6c7481 0 9px,transparent 9px 17px)}.cross-section-visual .ink{right:24%;bottom:54px;height:15px;border-radius:12px 12px 2px 2px;background:#d63f33}.cross-section-visual .squeegee{left:48%;right:auto;bottom:64px;width:22px;height:67px;background:#303744;transform:rotate(22deg);transform-origin:bottom}.screen-cross-section dl{display:grid;gap:0;margin:0}.screen-cross-section dl div{padding:17px 0;border-top:1px solid #d8dce3}.screen-cross-section dt{color:var(--navy);font-size:12px;font-weight:900}.screen-cross-section dd{margin:5px 0 0;color:#59647a;font-size:12px;line-height:1.75}
	.texture-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:28px}.texture{display:grid;min-height:112px;place-items:center;overflow:hidden;font-family:Georgia,serif;font-size:72px;font-weight:900;font-style:italic;letter-spacing:-.12em;text-shadow:2px 0 currentColor,-2px 1px currentColor;transform:rotate(-3deg)}.texture--red{background:#efe9dd;color:#d63f33}.texture--white{background:#172034;color:#f7f5f0}
	.notice{margin:34px 0;padding:23px 26px;border-left:4px solid var(--red);background:#fff5f2}.notice strong{color:var(--navy);font-size:14px}.notice p{margin:8px 0 0;color:#67524f;font-size:12px;line-height:1.8}
	.next-action{display:flex;justify-content:space-between;gap:30px;align-items:center;padding:36px;background:#f5f3ee}.next-action h2{max-width:700px}
	.related-section{padding:58px 0 16px}.related-section>h2{margin-bottom:22px}.related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.related-grid a{display:block;border:1px solid #d8dce3;color:var(--navy);text-decoration:none}.related-grid img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}.related-grid span{display:flex;flex-direction:column;padding:15px}.related-grid small{color:var(--red);font-size:8px;font-weight:900;letter-spacing:.14em}.related-grid strong{margin-top:5px;font-size:14px}
	@media(max-width:900px){.screen-steps{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.screen-steps>li,.screen-steps>li:nth-child(4),.screen-steps>li:nth-child(5){grid-column:auto;min-height:390px}.screen-steps>li:last-child{grid-column:1 / -1}.screen-explainers{grid-template-columns:1fr}.screen-explainers article:first-child{grid-row:auto}}
	@media(max-width:800px){.detail-hero{grid-template-columns:1fr;gap:28px}.detail-copy{order:1}.detail-hero figure{order:0}.fit-section,.process-section{grid-template-columns:1fr;gap:24px}.detail-columns{grid-template-columns:1fr;gap:38px}.process-guide{padding:58px 0 62px}.process-guide-copy{grid-template-columns:1fr;gap:18px;margin-bottom:38px}.process-guide-copy .section-kicker,.process-guide-copy h2,.process-guide-copy>p:last-child{grid-column:1;grid-row:auto}.next-action{align-items:flex-start;flex-direction:column}.related-grid{grid-template-columns:1fr}.related-grid a{display:grid;grid-template-columns:120px 1fr}.related-grid img{height:100%;aspect-ratio:1}.process-section ol{grid-template-columns:1fr}.process-section li{min-height:0}.process-section li p{margin-top:22px}}
	@media(max-width:560px){.screen-steps{grid-template-columns:1fr;gap:22px}.screen-steps>li,.screen-steps>li:last-child{grid-column:auto;min-height:0;padding:22px}.step-art{min-height:170px}.screen-explainers{gap:22px;margin-top:52px}.screen-explainers article{padding:26px 22px}.shirt-pair{grid-template-columns:1fr;gap:26px}.shirt{min-height:210px}.fit-section ul{grid-template-columns:1fr}.hero-actions{align-items:flex-start;flex-direction:column}.detail-copy h1{font-size:38px}.tagline{font-size:17px}}
</style>
