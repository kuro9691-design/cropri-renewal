---
import Base from "../layouts/Base.astro";
import HomePage from "../components/HomePage.astro";
import { getEmDashCollection } from "emdash";
const audit = Astro.url.searchParams.get("audit") === "migration";
const importedPages = audit ? (await getEmDashCollection("pages", { limit: 100 })).entries : [];
const auditRows = importedPages.map((page:any) => {
	const serialized = JSON.stringify(page.data.content ?? []);
	return { slug:page.id,title:page.data.title,status:page.data.status,blocks:Array.isArray(page.data.content)?page.data.content.length:0,chars:serialized.length,shortcodes:(serialized.match(/\[[a-zA-Z_][^\]]*\]/g)??[]).length,images:serialized.split("https://cropri.com/wp-content/uploads").length-1 };
});
---
<Base title="オリジナルウェア・プリント制作｜CROPRI" fullWidth={!audit}>
	{audit ? <><p class="status">LOCAL MIGRATION AUDIT</p><h1>WordPress固定ページの取込結果</h1><p>{auditRows.length}件。画像は元URL参照のままです。</p><div class="card" style="overflow:auto"><table><thead><tr><th>タイトル</th><th>slug</th><th>状態</th><th>blocks</th><th>文字</th><th>shortcode</th><th>画像</th></tr></thead><tbody>{auditRows.map(row=><tr><td><a href={`/${row.slug}`}>{row.title}</a></td><td>{row.slug}</td><td>{row.status}</td><td>{row.blocks}</td><td>{row.chars}</td><td>{row.shortcodes}</td><td>{row.images}</td></tr>)}</tbody></table></div></> : <HomePage />}
	{false && <>
	<section class="home-cover" aria-labelledby="home-title">
		<div class="home-copy">
			<p class="home-kicker">CROPRI ORIGINAL PRINT / KURE, HIROSHIMA</p>
			<h1 id="home-title"><span>オリジナルTシャツを</span><br /><span>ちゃんとつくる。</span></h1>
			<p class="home-lede">Tシャツ選びからデザイン、プリントまで。迷うところを一緒に整理して、使う日が楽しみになる一枚をつくります。</p>
			<div class="home-cta"><a class="button button-dark" href="/products/5001">定番Tシャツを見る</a><a class="text-link" href="/estimate">料金を計算する <span aria-hidden="true">→</span></a></div>
			<ul class="home-facts" aria-label="CROPRIの特徴"><li><strong>61</strong><span>COLORS</span></li><li><strong>1枚〜</strong><span>SMALL LOT</span></li><li><strong>3</strong><span>PRINT METHODS</span></li></ul>
		</div>
		<figure class="home-visual">
			<img src="/cropri/5001-images/model/A-254.jpg" alt="白い5001 Tシャツを着用したモデル" />
			<figcaption><span>STANDARD BODY</span><strong>United Athle 5001</strong><small>5.6 oz / 全61色</small></figcaption>
		</figure>
	</section>
	<section class="home-route" aria-labelledby="route-title">
		<div class="section-title"><p>START HERE</p><h2 id="route-title">どう進めますか？</h2></div>
		<div class="route-grid">
			<a href="/products/5001"><span>01</span><h3>商品から選ぶ</h3><p>まずは定番の5001から。色・サイズ・在庫の目安を見ながら選べます。</p><strong>商品を見る →</strong></a>
			<a href="/estimate"><span>02</span><h3>料金を知る</h3><p>枚数とプリント位置を選ぶと、その場で概算料金が分かります。</p><strong>概算見積もり →</strong></a>
			<a href="/contact"><span>03</span><h3>相談して決める</h3><p>手書きのラフや画像からでも大丈夫です。用途に合わせて整理します。</p><strong>問い合わせる →</strong></a>
		</div>
	</section>
	</>}
</Base>
<style>
table{border-collapse:collapse;width:100%;font-size:.85rem}th,td{border-bottom:1px solid #ddd;padding:8px;text-align:left;white-space:nowrap}th{background:var(--ink);color:white}
.home-cover{display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,.8fr);min-height:630px;border-bottom:1px solid #bdbdbd}.home-copy{padding:48px clamp(20px,6vw,76px) 48px 0;display:flex;flex-direction:column}.home-kicker,.section-title p{font-size:11px;font-weight:900;letter-spacing:.18em;margin:0 0 20px}.home-copy h1{font-size:clamp(46px,4.5vw,58px);line-height:1.08;letter-spacing:-.045em;color:#111;margin:0}.home-copy h1 span{white-space:nowrap}.home-lede{max-width:620px;font-size:16px;line-height:1.85;margin:22px 0;color:#333}.home-cta{display:flex;align-items:center;gap:28px}.button-dark{background:#111}.text-link{color:#111;font-weight:900;text-underline-offset:5px}.home-facts{display:flex;list-style:none;padding:0;margin:auto 0 0;border-block:1px solid #aaa}.home-facts li{flex:1;padding:17px 14px 15px 0;border-right:1px solid #aaa}.home-facts li+li{padding-left:20px}.home-facts strong,.home-facts span{display:block}.home-facts strong{font:700 26px/1 Georgia,serif}.home-facts span{font-size:9px;letter-spacing:.14em;margin-top:6px}.home-visual{position:relative;margin:0;min-height:630px;background:#eee;overflow:hidden}.home-visual img{width:100%;height:100%;object-fit:cover;object-position:center 25%;display:block;filter:grayscale(100%)}.home-visual figcaption{position:absolute;left:0;right:0;bottom:0;background:#111;color:#fff;padding:21px 24px;display:grid;grid-template-columns:1fr auto;align-items:end}.home-visual figcaption span{grid-column:1/-1;font-size:9px;letter-spacing:.18em}.home-visual figcaption strong{font-size:18px}.home-visual figcaption small{font-size:11px}.home-route{padding:clamp(70px,9vw,120px) 0}.section-title{display:flex;justify-content:space-between;align-items:end;border-bottom:3px solid #111;padding-bottom:22px}.section-title p{margin:0}.section-title h2{font-size:clamp(32px,5vw,58px);color:#111;margin:0}.route-grid{display:grid;grid-template-columns:repeat(3,1fr)}.route-grid>a{color:#111;text-decoration:none;padding:32px 28px 38px 0;border-bottom:1px solid #aaa;border-right:1px solid #aaa}.route-grid>a+a{padding-left:28px}.route-grid>a:last-child{border-right:0}.route-grid span{font:700 13px Georgia,serif}.route-grid h3{font:700 clamp(23px,3vw,32px) Georgia,"Noto Serif JP",serif;margin:30px 0 14px}.route-grid p{line-height:1.8;color:#444;min-height:5.4em}.route-grid strong{display:block;margin-top:28px;font-size:13px;text-decoration:underline;text-underline-offset:5px}
@media(max-width:800px){.home-cover{grid-template-columns:1fr}.home-copy{padding:54px 0}.home-visual{min-height:520px}.home-facts{margin-top:48px}.route-grid{grid-template-columns:1fr}.route-grid>a,.route-grid>a+a{padding:28px 0;border-right:0}.route-grid p{min-height:0}.section-title{display:block}.section-title h2{margin-top:10px}}
@media(max-width:520px){.home-copy h1{font-size:34px}.home-cta{align-items:flex-start;flex-direction:column;gap:18px}.home-facts li+li{padding-left:10px}.home-facts strong{font-size:21px}.home-visual{min-height:430px;margin-inline:-16px}.home-route{padding-bottom:60px}}
</style>
